{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es6",
		"outDir": "out",
		"lib": ["es6", "dom"],
		"sourceMap": true,
		"inlineSourceMap": false,
		"inlineSources": true,
			"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		// TypeScript 6 no longer auto-includes every package in node_modules/@types,
		// so global-providing type packages must be listed explicitly.
		"types": ["jest", "node", "vscode"]
	},
	"exclude": ["node_modules/", ".vscode-test/", "apiplayground/", "dist/", "codebook-md/", "tooling/", "test/"]
}
